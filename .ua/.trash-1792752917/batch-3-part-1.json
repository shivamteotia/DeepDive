  {
   "id": "file:dedup.py",
   "type": "file",
   "name": "dedup.py",
   "filePath": "dedup.py",
   "summary": "Groups reference records from several exports into papers via union-find on DOI, PMID/PMCID, then normalised title + first author + year, refusing merges across different DOIs/PMIDs or preprint-vs-article; lists near-identical titles as possible duplicates.",
   "tags": [
    "deduplication",
    "union-find",
    "systematic-review",
    "references",
    "utility"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:evaluate_dedup.py",
   "type": "file",
   "name": "evaluate_dedup.py",
   "filePath": "evaluate_dedup.py",
   "summary": "Free offline evaluation of the dedup step on bibliography/ exports: uses shared PMIDs as ground truth and a blind run with identifiers stripped to measure false merges and missed pairs, writing results to data/evals.",
   "tags": [
    "evaluation",
    "deduplication",
    "cli",
    "metrics",
    "entry-point"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:evaluate_screening.py",
