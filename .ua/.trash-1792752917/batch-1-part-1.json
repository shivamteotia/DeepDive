    "agent",
    "langgraph",
    "tool-calling",
    "service",
    "entry-point"
   ],
   "complexity": "complex",
   "languageNotes": "Uses Pydantic models converted to strict JSON schemas for OpenAI Responses API function calling, and a TypedDict state with Annotated reducers for LangGraph."
